<phpunit
    bootstrap=".config/bootstrap.php"
    backupGlobals="false"
    colors="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    >
    <testsuites>
        <testsuite name="content-expiration">
            <directory suffix=".php">./.tests/</directory>
        </testsuite>
    </testsuites>
</phpunit>
